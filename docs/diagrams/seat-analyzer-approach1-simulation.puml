@startuml Seat Analyzer - Approach 1: Enhanced Simulation
!theme aws-orange

title Seat Vacancy Analyzer - Approach 1: Enhanced Simulation Architecture

skinparam backgroundColor #f8f9fa
skinparam defaultFontSize 11

package "Frontend (React + TypeScript)" as Frontend {
  component [3D Bus Visualization] as Bus3D
  component [Enhanced Seat Map] as SeatMap
  component [Seat Analytics Dashboard] as Analytics
  component [Real-time Updates] as RealtimeUI
  
  Bus3D -down-> SeatMap : contains
  SeatMap -down-> Analytics : feeds data
}

package "Backend Services (Node.js)" as Backend {
  component [Seat Simulation Service] as SimService
  component [Pattern Generation Engine] as PatternEngine
  component [Crowd Prediction API] as CrowdAPI
  component [WebSocket Handler] as WSHandler
  
  SimService -right-> PatternEngine : uses
  CrowdAPI -up-> SimService : triggers
  WSHandler -up-> RealtimeUI : broadcasts
}

package "Database (PostgreSQL)" as Database {
  component [seat_layouts] as SeatLayouts
  component [seat_occupancy_simulation] as SeatSim
  component [crowd_history] as CrowdHist
  component [seat_patterns] as SeatPatterns
  
  SeatLayouts -down-> SeatSim : references
  CrowdHist -right-> SeatPatterns : influences
}

package "Simulation Logic" as Logic {
  component [Realistic Pattern Generator] as PatGen
  component [Time-based Simulation] as TimeSim
  component [Route-aware Logic] as RouteLogic
  component [Passenger Behavior Model] as BehaviorModel
  
  PatGen -down-> TimeSim : triggers
  TimeSim -right-> RouteLogic : considers
  RouteLogic -down-> BehaviorModel : applies
}

' Connections
Frontend -down-> Backend : API calls
Backend -down-> Database : queries
Backend -left-> Logic : executes
Logic -up-> Database : stores patterns

' Flow annotations
note right of PatGen
  **Simulation Features:**
  • Window/aisle preferences
  • Age-based seating patterns
  • Route-specific behavior
  • Time-of-day variations
  • Crowd level influence
end note

note bottom of Database
  **Quick Implementation:**
  • No hardware required
  • Realistic patterns
  • Demo-ready in 1-2 weeks
  • Foundation for future upgrades
end note

@enduml
