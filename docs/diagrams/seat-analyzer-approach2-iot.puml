@startuml Seat Analyzer - Approach 2: IoT Integration
!theme aws-orange

title Seat Vacancy Analyzer - Approach 2: IoT-Integrated System

skinparam backgroundColor #f8f9fa
skinparam defaultFontSize 11

package "Physical Bus Hardware" as Hardware {
  component [Pressure Sensors] as Sensors
  component [Weight Sensors] as WeightSensor
  component [IoT Gateway] as Gateway
  component [Bus Controller] as BusCtrl
  
  Sensors -right-> Gateway : sensor data
  WeightSensor -up-> Gateway : weight data
  Gateway -down-> BusCtrl : aggregated data
}

package "IoT Communication Layer" as IoTLayer {
  component [MQTT Broker] as MQTT
  component [Edge Processing] as EdgeProc
  component [Data Validation] as DataVal
  component [Real-time Buffer] as Buffer
  
  BusCtrl -down-> MQTT : publishes
  MQTT -right-> EdgeProc : processes
  EdgeProc -down-> DataVal : validates
  DataVal -right-> Buffer : stores
}

package "Backend Services (Node.js)" as Backend {
  component [IoT Data Processor] as IoTProcessor
  component [Seat Status Manager] as SeatManager
  component [Real-time API] as RealtimeAPI
  component [Analytics Engine] as Analytics
  component [Socket.IO Server] as SocketServer
  
  Buffer -down-> IoTProcessor : consumes
  IoTProcessor -right-> SeatManager : updates
  SeatManager -down-> RealtimeAPI : serves
  SeatManager -right-> Analytics : feeds
  RealtimeAPI -down-> SocketServer : broadcasts
}

package "Database (PostgreSQL)" as Database {
  component [real_time_seat_status] as RealTimeSeats
  component [seat_analytics] as SeatAnalytics
  component [iot_device_status] as DeviceStatus
  component [sensor_calibration] as Calibration
  
  RealTimeSeats -right-> SeatAnalytics : aggregates
  DeviceStatus -down-> Calibration : references
}

package "Frontend (React)" as Frontend {
  component [Live Seat Map] as LiveMap
  component [Real-time Dashboard] as Dashboard
  component [IoT Health Monitor] as HealthMonitor
  component [Seat Booking Interface] as Booking
  
  LiveMap -right-> Dashboard : integrates
  Dashboard -down-> HealthMonitor : monitors
  LiveMap -down-> Booking : enables
}

package "Mobile App Features" as Mobile {
  component [Push Notifications] as Push
  component [Seat Availability Alerts] as Alerts
  component [Pre-boarding Check] as PreBoard
  
  Push -right-> Alerts : triggers
  Alerts -down-> PreBoard : enables
}

' Main data flow
Hardware -down-> IoTLayer : real-time data
IoTLayer -down-> Backend : processed data
Backend -down-> Database : stores
Backend -right-> Frontend : serves
Backend -up-> Mobile : notifies

' Real-time connections
SocketServer -up-> LiveMap : WebSocket
SocketServer -up-> Dashboard : updates
SocketServer -right-> Mobile : notifications

note right of Hardware
  **IoT Sensors:**
  • Pressure-sensitive seat pads
  • Weight detection (50-150kg range)
  • Infrared occupancy sensors
  • Temperature sensors for validation
  • Battery-powered with wireless
end note

note bottom of Backend
  **Real-time Processing:**
  • MQTT message handling
  • Sensor data validation
  • Confidence scoring
  • Anomaly detection
  • Historical pattern matching
end note

note left of Frontend
  **User Features:**
  • Live seat availability
  • Seat reservation
  • Real-time updates
  • Occupancy predictions
  • IoT system health
end note

@enduml
